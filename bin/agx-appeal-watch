#!/usr/bin/env python3
"""
agx-appeal-watch — Isolated health/unban watcher for bad/appealed Antigravity accounts.
- Probes bad accounts (auto-discovered or from watchlist file) in an isolated environment
- Never triggers pool-wide PAUSED file
- Auto-recovers accounts passing a real `agy -p` check back to `status=ok`
- Optional notification hook via --notify-cmd / AGX_WATCH_NOTIFY_CMD (receives markdown on stdin)
- Never reads, logs, or prints OAuth tokens
"""
from __future__ import annotations

import argparse
import datetime
import glob
import json
import os
import pwd
import re
import shutil
import socket
import subprocess
from pathlib import Path


def resolve_real_home() -> Path:
    env_home = (os.environ.get("AGYX_REAL_HOME") or "").strip()
    if env_home:
        return Path(env_home)
    try:
        return Path(pwd.getpwuid(os.getuid()).pw_dir)
    except Exception:
        return Path.home()


def load_config_env(real_home: Path) -> None:
    cfg = Path(os.environ.get("AGX_CONFIG") or (real_home / ".config/agx/config.env"))
    if not cfg.is_file():
        return
    try:
        for ln in cfg.read_text(encoding="utf-8", errors="ignore").splitlines():
            s = ln.strip()
            if not s or s.startswith("#") or "=" not in s:
                continue
            k, v = s.split("=", 1)
            k = k.strip()
            v = v.strip().strip('"').strip("'")
            if k and k not in os.environ:
                os.environ[k] = v
    except OSError:
        pass


REAL_HOME = resolve_real_home()
load_config_env(REAL_HOME)
POOL_ROOT = Path(os.environ.get("AGYX_ROOT") or (REAL_HOME / ".local/share/agy-pool"))
ACC_ROOT = POOL_ROOT / "accounts"
STATE_FILE = POOL_ROOT / "appeal-watch-state.json"
DEFAULT_WATCHLIST_FILE = POOL_ROOT / "watchlist.txt"
AGY_BIN = os.environ.get("AGYX_AGY") or (
    str(REAL_HOME / ".local/bin/agy") if (REAL_HOME / ".local/bin/agy").exists() else (shutil.which("agy") or "agy")
)
PROXY = os.environ.get("AGYX_PROXY", "keep")
NO_PROXY = os.environ.get("AGYX_NO_PROXY", "localhost,127.0.0.1,::1,10.0.0.0/8")


def now_str() -> str:
    return datetime.datetime.now().astimezone().strftime("%Y-%m-%d %H:%M:%S %Z")


def now_iso() -> str:
    return datetime.datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z")


def isolated_env(acct: str) -> dict[str, str]:
    h = str(ACC_ROOT / acct / "home")
    env = {
        "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
        "HOME": h,
        "GEMINI_HOME": f"{h}/.gemini",
        "AGYX_REAL_HOME": str(REAL_HOME),
        "TMPDIR": "/tmp",
        "SSH_CONNECTION": "127.0.0.1 0 127.0.0.1 0",
        "AGY_ACP_FORCE_FILE_STORAGE": "1",
        "AGY_CLI_DISABLE_AUTO_UPDATE": "1",
    }
    if PROXY and PROXY != "keep":
        for k in ("http_proxy", "https_proxy", "HTTP_PROXY", "HTTPS_PROXY", "all_proxy", "ALL_PROXY"):
            env[k] = PROXY
        env["no_proxy"] = NO_PROXY
        env["NO_PROXY"] = NO_PROXY
    else:
        for k in ("http_proxy", "https_proxy", "HTTP_PROXY", "HTTPS_PROXY", "all_proxy", "ALL_PROXY", "no_proxy", "NO_PROXY"):
            if k in os.environ:
                env[k] = os.environ[k]
    return env


def parse_log_reason(log_dir: str) -> str:
    files = sorted(glob.glob(f"{log_dir}/*.log"), key=os.path.getmtime, reverse=True)
    text = ""
    for f in files[:2]:
        try:
            text += Path(f).read_text(encoding="utf-8", errors="ignore") + "\n"
        except OSError:
            pass
    if "TOS_VIOLATION" in text or "violation of Terms of Service" in text:
        return "TOS_VIOLATION"
    if "VALIDATION_REQUIRED" in text or "p=al_alert" in text:
        return "VALIDATION_REQUIRED"
    if "18 years old" in text or "verified your age" in text:
        return "年龄未验证"
    if "not currently available in your location" in text:
        return "地区不支持"
    if "SUBSCRIPTION_REQUIRED" in text or "valid license of this product" in text:
        return "SUBSCRIPTION_REQUIRED"
    if "invalid_grant" in text or "Not logged into Antigravity" in text:
        return "TOKEN_EXPIRED"
    m = re.search(r"Account ineligible: ([^\n.]+)", text)
    if m:
        return f"不符合资格:{m.group(1)[:40]}"
    return ""


def probe_account(acct: str) -> tuple[bool, str, str]:
    env = isolated_env(acct)
    log_dir = str(ACC_ROOT / acct / "home/.gemini/antigravity-cli/log")
    try:
        r = subprocess.run(
            [AGY_BIN, "-p", "Reply with exactly: OK"],
            cwd="/tmp",
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=55,
        )
    except subprocess.TimeoutExpired:
        return False, "超时(55s)", ""

    combined = (r.stdout or "") + "\n" + (r.stderr or "")
    reason = parse_log_reason(log_dir)
    if r.returncode == 0 and "OK" in (r.stdout or "") and not reason:
        usage_str = ""
        try:
            ru = subprocess.run(
                [AGY_BIN, "-p", "/usage"],
                cwd="/tmp",
                env=env,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=35,
            )
            txt = (ru.stdout or "") + "\n" + (ru.stderr or "")
            gm = re.findall(r"(\d+)%", txt)
            if gm:
                usage_str = "额度=" + "/".join(f"{x}%" for x in gm[:4])
        except Exception:
            pass
        return True, "OK", usage_str

    if not reason:
        if "TOS_VIOLATION" in combined or "violation of Terms of Service" in combined:
            reason = "TOS_VIOLATION"
        else:
            reason = f"调用失败(rc={r.returncode})"
    return False, reason, ""


def load_targets(watchlist_path: Path | None, auto_bad: bool) -> list[str]:
    targets: list[str] = []
    if watchlist_path and watchlist_path.is_file():
        for ln in watchlist_path.read_text(encoding="utf-8", errors="ignore").splitlines():
            s = ln.split("#", 1)[0].strip()
            if s and s not in targets:
                targets.append(s)
    if auto_bad or not targets:
        if ACC_ROOT.is_dir():
            for d in sorted(ACC_ROOT.iterdir()):
                st_f = d / "status"
                if not d.is_dir() or not st_f.is_file():
                    continue
                st = st_f.read_text(encoding="utf-8", errors="ignore").strip()
                if st.startswith("bad:") and d.name not in targets:
                    targets.append(d.name)
    return targets


def load_state() -> dict:
    if STATE_FILE.exists():
        try:
            return json.loads(STATE_FILE.read_text(encoding="utf-8"))
        except Exception:
            pass
    return {"accounts": {}, "last_run": ""}


def save_state(st: dict) -> None:
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_suffix(f".tmp.{os.getpid()}")
    tmp.write_text(json.dumps(st, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, STATE_FILE)


def main() -> int:
    ap = argparse.ArgumentParser(description="Isolated unban/health watcher for bad agx accounts")
    ap.add_argument("--watchlist", type=Path, default=DEFAULT_WATCHLIST_FILE, help="Optional newline-separated account watchlist file")
    ap.add_argument("--all-bad", action="store_true", help="Include all bad:* accounts in pool")
    ap.add_argument("--dry-run", action="store_true", help="Probe without writing status or invoking notify command")
    ap.add_argument("--force-notify", action="store_true", help="Always invoke notify command even if no status changed")
    ap.add_argument("--notify-cmd", default=os.environ.get("AGX_WATCH_NOTIFY_CMD", ""), help="Optional shell command receiving markdown report on stdin")
    args = ap.parse_args()

    targets = load_targets(args.watchlist, args.all_bad)
    st = load_state()
    prev = st.get("accounts", {})
    adopted, unadopted = [], []

    for acct in targets:
        tok = ACC_ROOT / acct / "home/.gemini/antigravity-cli/antigravity-oauth-token"
        if not tok.exists():
            unadopted.append(acct)
            continue
        status_file = ACC_ROOT / acct / "status"
        cur_status = status_file.read_text(encoding="utf-8", errors="ignore").strip() if status_file.exists() else ""
        if cur_status == "ok":
            continue
        adopted.append(acct)

    recovered, changed, still_bad = [], [], []
    for acct in adopted:
        ok, reason, usage = probe_account(acct)
        old_reason = prev.get(acct, {}).get("reason", "")
        print(f"[{now_str()}] PROBE {acct}: ok={ok} reason={reason} {usage}", flush=True)
        if ok:
            recovered.append((acct, usage))
            if not args.dry_run:
                (ACC_ROOT / acct / "status").write_text("ok\n", encoding="utf-8")
        else:
            still_bad.append((acct, reason))
            if old_reason and old_reason != reason:
                changed.append((acct, old_reason, reason))
        prev[acct] = {"ok": ok, "reason": reason, "usage": usage, "checked_at": now_iso()}

    st["accounts"] = prev
    st["last_run"] = now_iso()
    if not args.dry_run:
        save_state(st)

    ok_total = 0
    if ACC_ROOT.is_dir():
        ok_total = sum(
            1
            for d in ACC_ROOT.iterdir()
            if d.is_dir() and (d / "status").exists() and (d / "status").read_text(encoding="utf-8", errors="ignore").strip() == "ok"
        )
    ts_short = datetime.datetime.now().astimezone().strftime("%m-%d %H:%M")
    host = socket.gethostname()
    lines = [f"**AGX 申诉账号存活巡检**（{ts_short} · {host}）"]
    if recovered:
        lines.append("已恢复可用并自动标 `ok`：")
        for acct, usage in recovered:
            lines.append(f"- `{acct}` {usage}")
    if changed:
        lines.append("状态变化：")
        for acct, old_r, new_r in changed:
            lines.append(f"- `{acct}`: `{old_r}` -> `{new_r}`")
    if still_bad:
        by_reason: dict[str, list[str]] = {}
        for acct, r in still_bad:
            by_reason.setdefault(r, []).append(acct)
        lines.append(f"仍不可用（{len(still_bad)} 个）：")
        for r, accts in by_reason.items():
            lines.append(f"- `{r}`（{len(accts)}）：" + "、".join(accts))
    if unadopted:
        lines.append(f"尚未登进池（{len(unadopted)} 个）：" + "、".join(unadopted))
    lines.append(f"当前可用池总计：**{ok_total} 个 `ok`**。")

    msg = "\n".join(lines)
    print("\n--- MESSAGE PREVIEW ---\n" + msg + "\n--- END PREVIEW ---", flush=True)

    hour = datetime.datetime.now().astimezone().hour
    should_notify = bool(recovered or changed or args.force_notify or hour == 10)
    if args.dry_run or not args.notify_cmd or not should_notify:
        return 0

    r = subprocess.run(args.notify_cmd, shell=True, input=msg, text=True, capture_output=True, timeout=30)
    if r.returncode != 0:
        print(f"[{now_str()}] NOTIFY FAILED rc={r.returncode}: {r.stderr.strip()[:200]}", flush=True)
        return 1
    print(f"[{now_str()}] NOTIFIED ok", flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
