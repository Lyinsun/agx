      建议每个 Google 账号使用独立的无痕浏览器窗口打开登录链接，避免复用已有登录态；收编后将在隔离环境中执行最小推理请求与 /usage 探测，不可用账号只标为 bad，不会暂停整池。
    </div>
  </div>

  <div class="card">
    <h2>
      <span>当前 agx 账号池</span>
      <span class="row">
        <span id="stagingInfo" class="muted"></span>
        <button id="btnCleanStaging" class="sec sm" style="display:none;" onclick="cleanStaging()">清理残留 staging</button>
        <button class="sec sm" onclick="loadPool()">刷新列表</button>
      </span>
    </h2>
    <div id="pausedBanner" class="status-bar bad" style="display:none;"></div>
    <table>
      <thead>
        <tr>
          <th>账号名</th>
          <th>邮箱</th>
          <th>状态</th>
          <th>额度 / 原因</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody id="poolBody"><tr><td colspan="5" class="muted">加载中…</td></tr></tbody>
    </table>
  </div>
</div>

<script>
let currentUrl = "";
let pollTimer = null;

function initToken() {
  const m = (location.hash || "").match(/token=([A-Za-z0-9._-]+)/);
  if (m) {
    localStorage.setItem("agx_web_token", m[1]);
    history.replaceState(null, "", location.pathname + location.search);
  }
  return localStorage.getItem("agx_web_token") || "";
}
let apiToken = initToken();

async function api(path, body) {
  const headers = {};
  if (apiToken) headers["X-AGX-Token"] = apiToken;
  const opt = body !== undefined
    ? { method: "POST", headers: { ...headers, "Content-Type": "application/json" }, body: JSON.stringify(body) }
    : { headers };
  const r = await fetch(path, opt);
  if (r.status === 401) {
    const t = prompt("需要访问令牌（查看启动输出或 ~/.local/share/agy-pool/web.token）：", apiToken);
    if (t && t.trim()) {
      apiToken = t.trim();
      localStorage.setItem("agx_web_token", apiToken);
      return await api(path, body);
    }
    throw new Error("unauthorized");
  }
  return await r.json();
}

function renderState(st) {
  const bar = document.getElementById("statusBar");
  const btnStart = document.getElementById("btnStart");
  const btnOpen = document.getElementById("btnOpen");
  const btnCopy = document.getElementById("btnCopy");
  const urlBox = document.getElementById("urlBox");
  const codeArea = document.getElementById("codeArea");
  const btnSubmit = document.getElementById("btnSubmit");

  bar.className = "status-bar" + (st.phase === "done" && st.last_result.startsWith("✅") ? " ok" : st.phase === "error" || (st.last_result || "").startsWith("❌") ? " bad" : st.phase === "waiting_code" ? " warn" : "");
  bar.textContent = st.message + (st.updated_at ? "  [" + st.updated_at.slice(11, 19) + "]" : "");

  const busy = ["starting", "adopting", "testing"].includes(st.phase);
  btnStart.disabled = busy;
  btnSubmit.disabled = busy;

  if (st.url && st.phase === "waiting_code") {
    currentUrl = st.url;
    urlBox.textContent = st.url;
    urlBox.style.display = "block";
    btnOpen.href = st.url;
    btnOpen.style.display = "inline-flex";
    btnCopy.style.display = "inline-flex";
    codeArea.style.display = "flex";
  } else {
    currentUrl = "";
    urlBox.style.display = "none";
    btnOpen.style.display = "none";
    btnCopy.style.display = "none";
    codeArea.style.display = "none";
  }

  if (busy && !pollTimer) {
    pollTimer = setInterval(refreshAll, 2000);
  } else if (!busy && pollTimer) {
    clearInterval(pollTimer);
    pollTimer = null;
    loadPool();
  }
}

async function refreshAll() {
  const st = await api("/api/state");
  renderState(st);
}

async function loadPool() {
  const data = await api("/api/pool");
  const paused = document.getElementById("pausedBanner");
  if (data.paused) {
    paused.textContent = "⚠ 整池暂停：" + data.paused;
    paused.style.display = "block";
  } else {
    paused.style.display = "none";
  }
  const stInfo = document.getElementById("stagingInfo");
  const btnClean = document.getElementById("btnCleanStaging");
  if (data.stagings && data.stagings.length) {
    stInfo.textContent = "残留临时目录：" + data.stagings.length + " 个";
    btnClean.style.display = "inline-flex";
  } else {
    stInfo.textContent = "";
    btnClean.style.display = "none";
  }

  const tbody = document.getElementById("poolBody");
  if (!data.accounts || !data.accounts.length) {
    tbody.innerHTML = '<tr><td colspan="5" class="muted">账号池为空</td></tr>';
    return;
  }
  tbody.innerHTML = data.accounts.map(a => {
    const cls = a.status === "ok" ? "ok" : a.status.startsWith("exhausted") ? "ex" : "bad";
    const info = a.status === "ok" ? (a.usage || '<span class="muted">暂无缓存（点复测读取）</span>') : (a.reason || a.status);
    return `<tr>
      <td><b>${esc(a.acct)}</b></td>
      <td>${esc(a.email)}</td>
      <td><span class="pill ${cls}">${esc(a.status.slice(0, 26))}</span></td>
      <td>${a.status === "ok" ? info : esc(info)}</td>
      <td class="row">
        <button class="sm" onclick="retest('${esc(a.acct)}', this)">复测</button>
        ${a.status !== "ok" ? `<button class="sm ok" onclick="setStatus('${esc(a.acct)}','ok')">标ok</button>` : `<button class="sm sec" onclick="setStatus('${esc(a.acct)}','bad:手动停用')">停用</button>`}
        <button class="sm bad" onclick="removeAcct('${esc(a.acct)}')">删号</button>
      </td>
    </tr>`;
  }).join("");
}

function esc(s) {
  return String(s || "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}

async function startLogin() {
  document.getElementById("codeInput").value = "";
  const st = await api("/api/login/start", {});
  renderState(st);
}

async function cancelLogin() {
  const st = await api("/api/login/cancel", {});
  renderState(st);
}

async function submitCode() {
  const code = document.getElementById("codeInput").value.trim();
  if (!code) { alert("请先粘贴 4/0A... 授权码"); return; }
  document.getElementById("codeInput").value = "";
  const st = await api("/api/login/submit", { code });
  renderState(st);
}

async function copyUrl() {
  if (!currentUrl) return;
  try { await navigator.clipboard.writeText(currentUrl); alert("已复制登录链接，可粘贴到无痕窗口打开"); }
  catch { prompt("请复制下方链接：", currentUrl); }
}

async function retest(acct, btn) {
  btn.disabled = true; btn.textContent = "测试中…";
  const r = await api("/api/account/test", { acct });
  alert(acct + "：" + (r.ok ? "✅ " : "❌ ") + r.detail);
  loadPool();
}

async function setStatus(acct, status) {
  await api("/api/account/status", { acct, status });
  loadPool();
}

async function removeAcct(acct) {
  if (!confirm("确认从 agx 账号池删除 " + acct + " ？")) return;
  await api("/api/account/delete", { acct });
  loadPool();
}

async function cleanStaging() {
  if (!confirm("确认清理所有残留的 .staging.* 临时目录？")) return;
  await api("/api/staging/clean", {});
  loadPool();
}

refreshAll();
loadPool();
</script>
</body>
</html>
"""


class ThreadingHTTPServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        # Suppress default request logging so nothing sensitive can ever appear in logs
        pass

    def send_json(self, obj, code=200):
        raw = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def read_json(self):
        n = int(self.headers.get("Content-Length", "0") or "0")
        if n <= 0 or n > 1024 * 64:
            return {}
        return json.loads(self.rfile.read(n).decode("utf-8"))

    def check_auth(self):
        tok = (self.headers.get("X-AGX-Token") or "").strip()
        if not tok:
            auth = (self.headers.get("Authorization") or "").strip()
            if auth.lower().startswith("bearer "):
                tok = auth[7:].strip()
        if tok and hmac.compare_digest(tok, API_TOKEN):
            return True
        self.send_json({"error": "unauthorized"}, 401)
        return False

    def do_GET(self):
        p = urlparse(self.path).path
        if p == "/":
            raw = HTML_PAGE.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(raw)))
            self.end_headers()
            self.wfile.write(raw)
        elif p == "/api/state":
            if not self.check_auth():
                return
            self.send_json(get_state())
        elif p == "/api/pool":
            if not self.check_auth():
                return
            self.send_json(list_pool())
        else:
            self.send_json({"error": "not found"}, 404)

    def do_POST(self):
        p = urlparse(self.path).path
        if p.startswith("/api/") and not self.check_auth():
            return
        body = self.read_json()
        if p == "/api/login/start":
            if get_state()["phase"] in ("starting", "adopting", "testing"):
                self.send_json(get_state())
                return
            threading.Thread(target=worker_start_login, daemon=True).start()
            time.sleep(0.1)
            self.send_json(get_state())
        elif p == "/api/login/cancel":
            kill_tmux()
            set_state(phase="idle", url="", message="已重置登录会话，点击「生成新登录链接」重新开始")
            self.send_json(get_state())
        elif p == "/api/login/submit":
            code = str(body.get("code", "")).strip()
            if not code:
                self.send_json({"error": "empty code"}, 400)
                return
            if get_state()["phase"] != "waiting_code":
                self.send_json(get_state())
                return
            threading.Thread(target=worker_submit_code, args=(code,), daemon=True).start()
            time.sleep(0.1)
            self.send_json(get_state())
        elif p == "/api/account/test":
            acct = re.sub(r"[^a-zA-Z0-9._-]", "", str(body.get("acct", "")))
            if not acct or not (ACC_ROOT / acct).is_dir():
                self.send_json({"ok": False, "detail": "账号不存在"}, 404)
                return
            ok, detail = test_account_isolated(acct)
            self.send_json({"ok": ok, "detail": detail})
        elif p == "/api/account/status":
            acct = re.sub(r"[^a-zA-Z0-9._-]", "", str(body.get("acct", "")))
            status = str(body.get("status", "")).strip()
            if not acct or not (ACC_ROOT / acct).is_dir():
                self.send_json({"ok": False}, 404)
                return
            val = "ok" if status == "ok" else f"{status}:{now_iso()}"
            (ACC_ROOT / acct / "status").write_text(val + "\n", encoding="utf-8")
            self.send_json({"ok": True})
        elif p == "/api/account/delete":
            acct = re.sub(r"[^a-zA-Z0-9._-]", "", str(body.get("acct", "")))
            if not acct or not (ACC_ROOT / acct).is_dir():
                self.send_json({"ok": False}, 404)
                return
            shutil.rmtree(ACC_ROOT / acct, ignore_errors=True)
            order_file = POOL_ROOT / "order"
            if order_file.exists():
                kept = [ln for ln in order_file.read_text(encoding="utf-8").splitlines() if ln.strip() and ln.strip() != acct]
                order_file.write_text("\n".join(kept) + ("\n" if kept else ""), encoding="utf-8")
            self.send_json({"ok": True})
        elif p == "/api/staging/clean":
            for d in glob.glob(f"{POOL_ROOT}/.staging.*"):
                shutil.rmtree(d, ignore_errors=True)
            self.send_json({"ok": True})
        else:
            self.send_json({"error": "not found"}, 404)


if __name__ == "__main__":
    srv = ThreadingHTTPServer((HOST, PORT), Handler)
    print(f"agx_web listening on http://{HOST}:{PORT}/#token={API_TOKEN}", flush=True)
    srv.serve_forever()
