#!/usr/bin/env python3
"""
agx_web.py — Lightweight local web UI for logging in, adopting, and testing agx accounts.
- Never logs or persists OAuth codes, passwords, or token contents.
- Runs real usability checks in an isolated environment so bad accounts never pause the whole pool.
"""
import datetime
import glob
import hmac
import http.server
import json
import os
import pwd
import re
import secrets
import shlex
import shutil
import socketserver
import subprocess
import threading
import time
from pathlib import Path
from urllib.parse import urlparse


def resolve_real_home() -> str:
    env_home = (os.environ.get("AGYX_REAL_HOME") or "").strip()
    if env_home:
        return env_home
    try:
        return pwd.getpwuid(os.getuid()).pw_dir
    except Exception:
        return str(Path.home())


def load_config_env(real_home: str) -> None:
    cfg = Path(os.environ.get("AGX_CONFIG") or f"{real_home}/.config/agx/config.env")
    if not cfg.is_file():
        return
    try:
        lines = cfg.read_text(encoding="utf-8", errors="ignore").splitlines()
    except OSError:
        return
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[7:].lstrip()
        if "=" not in line:
            continue
        key, val = line.split("=", 1)
        key = key.strip()
        if not re.fullmatch(r"(AGYX|AGX)_[A-Z0-9_]+", key):
            continue
        if key in os.environ:
            continue
        val = val.strip()
        if len(val) >= 2 and ((val[0] == '"' and val[-1] == '"') or (val[0] == "'" and val[-1] == "'")):
            val = val[1:-1]
        else:
            if " #" in val:
                val = val.split(" #", 1)[0].strip()
        val = val.replace("$HOME", real_home).replace("${HOME}", real_home)
        os.environ[key] = val


REAL_HOME = resolve_real_home()
load_config_env(REAL_HOME)
POOL_ROOT = Path(os.environ.get("AGYX_ROOT") or f"{REAL_HOME}/.local/share/agy-pool")
ACC_ROOT = POOL_ROOT / "accounts"
TOKEN_FILE = POOL_ROOT / "web.token"
_default_agy = f"{REAL_HOME}/.local/bin/agy"
AGY_BIN = os.environ.get("AGYX_AGY") or (_default_agy if Path(_default_agy).exists() else (shutil.which("agy") or _default_agy))
_default_agx = f"{REAL_HOME}/.local/bin/agx"
AGX_BIN = os.environ.get("AGX_BIN") or (_default_agx if Path(_default_agx).exists() else (shutil.which("agx") or str(Path(__file__).resolve().with_name("agx"))))
PROXY = os.environ.get("AGYX_PROXY", "keep")
NO_PROXY = os.environ.get("AGYX_NO_PROXY", "localhost,127.0.0.1,::1,10.0.0.0/8")
PORT = int(os.environ.get("AGX_WEB_PORT", "8789"))
HOST = os.environ.get("AGX_WEB_HOST", "127.0.0.1").strip() or "127.0.0.1"
if HOST in ("0.0.0.0", "::") and os.environ.get("AGX_WEB_ALLOW_ANY") != "1":
    raise SystemExit("agx_web: 默认拒绝监听 0.0.0.0/::（请用 127.0.0.1 + ssh -L，或指定具体内网 IP；确实需要请设 AGX_WEB_ALLOW_ANY=1）")


def load_or_create_token():
    POOL_ROOT.mkdir(parents=True, exist_ok=True)
    if TOKEN_FILE.is_file():
        tok = TOKEN_FILE.read_text(encoding="utf-8").strip()
        if len(tok) >= 16:
            return tok
    tok = secrets.token_hex(24)
    tmp = TOKEN_FILE.with_suffix(".token.tmp")
    tmp.write_text(tok + "\n", encoding="utf-8")
    os.chmod(tmp, 0o600)
    os.replace(tmp, TOKEN_FILE)
    return tok


API_TOKEN = load_or_create_token()

BASE_ENV = os.environ.copy()
BASE_ENV["HOME"] = REAL_HOME
BASE_ENV["AGYX_REAL_HOME"] = REAL_HOME
BASE_ENV["TMPDIR"] = "/tmp"

TMUX_SESS = "agx-web-login"
STATE_LOCK = threading.Lock()
LOGIN_STATE = {
    "phase": "idle",  # idle | starting | waiting_code | adopting | testing | done | error
    "url": "",
    "message": "点击「生成新登录链接」开始添加账号",
    "last_account": "",
    "last_result": "",
    "updated_at": "",
    "staging_before": [],
}


def now_iso():
    return datetime.datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z")


def set_state(**kw):
    with STATE_LOCK:
        LOGIN_STATE.update(kw)
        LOGIN_STATE["updated_at"] = now_iso()


def get_state():
    with STATE_LOCK:
        return {k: v for k, v in LOGIN_STATE.items() if k != "staging_before"}


def run(cmd, env=None, timeout=60):
    return subprocess.run(
        cmd,
        env=env or BASE_ENV,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=timeout,
    )


def kill_tmux():
    run(["tmux", "kill-session", "-t", TMUX_SESS], timeout=10)


def extract_oauth_url(pane_text):
    buf = []
    bars = 0
    for ln in pane_text.splitlines():
        if ln.startswith(" ─") or ln.startswith("─"):
            bars += 1
            if bars == 2:
                break
            continue
        if bars == 1:
            buf.append(ln.strip())
    url = "".join(buf).replace(" ", "")
    return url if url.startswith("https://accounts.google.com/") else ""


def parse_log_reason(log_dir):
    files = sorted(glob.glob(f"{log_dir}/*.log"), key=os.path.getmtime, reverse=True)
    text = ""
    for f in files[:3]:
        try:
            text += Path(f).read_text(encoding="utf-8", errors="ignore") + "\n"
        except Exception:
            pass
    if "TOS_VIOLATION" in text or "violation of Terms of Service" in text:
        return "TOS_VIOLATION(已封禁)"
    if "VALIDATION_REQUIRED" in text or "p=al_alert" in text:
        return "VALIDATION_REQUIRED(需扫码验证)"
    if "18 years old" in text or "verified your age" in text:
        if "SUBSCRIPTION_REQUIRED" in text:
            return "年龄未验证+无订阅(#3501)"
        return "年龄未验证(18+)"
    if "not currently available in your location" in text:
        return "地区不支持"
    if "SUBSCRIPTION_REQUIRED" in text or "valid license of this product" in text:
        return "SUBSCRIPTION_REQUIRED(无有效订阅#3501)"
    m = re.search(r"Account ineligible: ([^\n.]+)", text)
    if m:
        return f"不符合资格: {m.group(1)}"
    m = re.search(r"Eligibility check failed: ([^\n]+)", text)
    if m:
        return f"资格校验失败: {m.group(1)[:80]}"
    m = re.search(r'"reason":\s*"([^"]+)"', text)
    if m:
        return m.group(1)
    return ""


def run_isolated_agy(acct, args, timeout=55):
    h = str(ACC_ROOT / acct / "home")
    tdir = ACC_ROOT / acct / "tmp"
    tdir.mkdir(parents=True, exist_ok=True)
    env = {
        "PATH": BASE_ENV.get("PATH", "/usr/bin:/bin"),
        "HOME": h,
        "GEMINI_HOME": f"{h}/.gemini",
        "AGYX_REAL_HOME": REAL_HOME,
        "TMPDIR": "/tmp",
        "SSH_CONNECTION": "127.0.0.1 0 127.0.0.1 0",
        "AGY_ACP_FORCE_FILE_STORAGE": "1",
        "AGY_CLI_DISABLE_AUTO_UPDATE": "1",
    }
    if PROXY == "keep":
        for k in ("http_proxy", "https_proxy", "HTTP_PROXY", "HTTPS_PROXY", "all_proxy", "ALL_PROXY", "no_proxy", "NO_PROXY"):
            if k in BASE_ENV:
                env[k] = BASE_ENV[k]
    else:
        env.update({
            "http_proxy": PROXY,
            "https_proxy": PROXY,
            "HTTP_PROXY": PROXY,
            "HTTPS_PROXY": PROXY,
            "all_proxy": PROXY,
            "ALL_PROXY": PROXY,
            "no_proxy": NO_PROXY,
            "NO_PROXY": NO_PROXY,
        })
    return subprocess.run(
        [AGY_BIN, *args],
        cwd="/tmp",
        env=env,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=timeout,
    )


def format_usage(u_path: Path):
    if not u_path.exists():
        return ""
    parts = []
    for ln in u_path.read_text(encoding="utf-8", errors="ignore").splitlines():
        cols = ln.split("\t")
        if len(cols) >= 3:
            grp = "Gemini" if cols[0].startswith("Gemini") else "Claude/GPT"
            win = "5h" if cols[1].startswith("Five") else "周"
            parts.append(f"{grp} {win}: {cols[2]}")
    ts = datetime.datetime.fromtimestamp(u_path.stat().st_mtime).strftime("%m-%d %H:%M")
    return " | ".join(parts) + f" ({ts})" if parts else ""


def test_account_isolated(acct: str):
    acc_dir = ACC_ROOT / acct
    st_file = acc_dir / "status"
    log_dir = str(acc_dir / "home/.gemini/antigravity-cli/log")
    if not (acc_dir / "home/.gemini/antigravity-cli/antigravity-oauth-token").exists():
        return False, "缺少登录凭据文件"
    try:
        r_inf = run_isolated_agy(acct, ["-p", "Reply with exactly: OK", "--print-timeout", "40s"], timeout=50)
        out = (r_inf.stdout or "") + "\n" + (r_inf.stderr or "")
        if r_inf.returncode != 0 or "OK" not in out:
            reason = parse_log_reason(log_dir)
            if not reason:
                m = re.search(r"(VALIDATION_REQUIRED|SUBSCRIPTION_REQUIRED|TOS_VIOLATION|Eligibility check failed[^\n]*|PERMISSION_DENIED[^\n]*)", out)
                reason = m.group(1)[:100] if m else f"调用失败 (rc={r_inf.returncode})"
            short = reason.split("(")[0].replace(":", "_").replace(" ", "_")[:24]
            st_file.write_text(f"bad:{short}:{now_iso()}\n", encoding="utf-8")
            return False, reason
    except subprocess.TimeoutExpired:
        st_file.write_text(f"bad:请求超时:{now_iso()}\n", encoding="utf-8")
        return False, "最小请求超时 (50s)"

    # Real inference succeeded -> mark ok & fetch usage
    st_file.write_text("ok\n", encoding="utf-8")
    usage_str = ""
    try:
        r_u = run_isolated_agy(acct, ["-p", "/usage"], timeout=40)
        lines = [ln for ln in (r_u.stdout or "").splitlines() if "\t" in ln]
        if lines:
            u_path = acc_dir / "usage.tsv"
            u_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
            usage_str = format_usage(u_path)
    except Exception:
        pass
    return True, f"实测可用{(' · ' + usage_str) if usage_str else ''}"


def list_pool():
    order_file = POOL_ROOT / "order"
    ordered = []
    if order_file.exists():
        for ln in order_file.read_text(encoding="utf-8", errors="ignore").splitlines():
            a = ln.strip()
            if a and (ACC_ROOT / a / "home/.gemini/antigravity-cli/antigravity-oauth-token").exists():
                if a not in ordered:
                    ordered.append(a)
    if ACC_ROOT.exists():
        for d in sorted(ACC_ROOT.iterdir()):
            if d.is_dir() and (d / "home/.gemini/antigravity-cli/antigravity-oauth-token").exists():
                if d.name not in ordered:
                    ordered.append(d.name)
    rows = []
    for a in ordered:
        d = ACC_ROOT / a
        email = (d / "email").read_text(encoding="utf-8", errors="ignore").strip() if (d / "email").exists() else ""
        status = (d / "status").read_text(encoding="utf-8", errors="ignore").strip() if (d / "status").exists() else "ok"
        usage = format_usage(d / "usage.tsv")
        reason = "" if status == "ok" else parse_log_reason(str(d / "home/.gemini/antigravity-cli/log"))
        rows.append({"acct": a, "email": email, "status": status, "usage": usage, "reason": reason})
    paused = (POOL_ROOT / "PAUSED").read_text(encoding="utf-8", errors="ignore").strip() if (POOL_ROOT / "PAUSED").exists() else ""
    stagings = [os.path.basename(p) for p in sorted(glob.glob(f"{POOL_ROOT}/.staging.*"))]
    return {"paused": paused, "accounts": rows, "stagings": stagings}


def worker_start_login():
    try:
        set_state(phase="starting", url="", message="正在启动隔离 agx login 并获取 Google OAuth 链接…", last_account="", last_result="")
        kill_tmux()
        staging_before = sorted(glob.glob(f"{POOL_ROOT}/.staging.*"))
        with STATE_LOCK:
            LOGIN_STATE["staging_before"] = staging_before
        cmd_str = (
            f"HOME={shlex.quote(REAL_HOME)} AGYX_REAL_HOME={shlex.quote(REAL_HOME)} "
            f"AGYX_ROOT={shlex.quote(str(POOL_ROOT))} TMPDIR=/tmp "
            f"{shlex.quote(AGX_BIN)} login; echo '[DONE rc='\\$?']'; sleep 300"
        )
        run([
            "tmux", "new-session", "-d", "-s", TMUX_SESS, "-x", "250", "-y", "50",
            cmd_str,
        ], timeout=15)
        time.sleep(5)
        run(["tmux", "send-keys", "-t", TMUX_SESS, "Enter"], timeout=10)
        url = ""
        for _ in range(8):
            time.sleep(1.5)
            pane = run(["tmux", "capture-pane", "-p", "-J", "-t", TMUX_SESS, "-S", "-60"], timeout=10).stdout
            url = extract_oauth_url(pane)
            if url:
                break
        if not url:
            kill_tmux()
            set_state(phase="error", url="", message="未能从 agx login 提取到 OAuth 链接，请重试")
            return
        set_state(phase="waiting_code", url=url, message="链接已就绪：请在浏览器（建议无痕窗口）打开登录，再将回调页的 4/0A... 授权码粘贴到下方提交。")
    except Exception as e:
        kill_tmux()
        set_state(phase="error", url="", message=f"启动失败：{e}")


def worker_submit_code(code: str):
    try:
        set_state(phase="adopting", message="已提交授权码，正在自动完成首次向导并收编进账号池（约 20 秒）…")
        run(["tmux", "send-keys", "-t", TMUX_SESS, "-l", code], timeout=10)
        time.sleep(0.8)
        run(["tmux", "send-keys", "-t", TMUX_SESS, "Enter"], timeout=10)
        time.sleep(6.5)

        for _ in range(3):
            run(["tmux", "send-keys", "-t", TMUX_SESS, "Enter"], timeout=10)
            time.sleep(1.3)
        run(["tmux", "send-keys", "-t", TMUX_SESS, "Down"], timeout=10)
        time.sleep(0.5)
        run(["tmux", "send-keys", "-t", TMUX_SESS, "Right"], timeout=10)
        time.sleep(0.5)
        run(["tmux", "send-keys", "-t", TMUX_SESS, "Enter"], timeout=10)
        time.sleep(2.5)
        run(["tmux", "send-keys", "-t", TMUX_SESS, "Enter"], timeout=10)
        time.sleep(2.5)
        run(["tmux", "send-keys", "-t", TMUX_SESS, "-l", "/exit"], timeout=10)
        time.sleep(0.5)
        run(["tmux", "send-keys", "-t", TMUX_SESS, "Enter"], timeout=10)

        saved_acct = ""
        pane = ""
        for _ in range(20):
            pane = run(["tmux", "capture-pane", "-p", "-J", "-t", TMUX_SESS, "-S", "-60"], timeout=10).stdout
            m = re.search(r"已保存：([^\s]+)\s*→\s*[^\n]*/accounts/([^\s/]+)", pane)
            if m:
                saved_acct = m.group(2).strip()
                break
            if "[DONE rc=" in pane:
                break
            time.sleep(2)
        kill_tmux()

        if not saved_acct:
            # Check if pane has a hint
            tail = " | ".join([ln.strip() for ln in pane.splitlines() if ln.strip()][-4:])
            set_state(phase="error", url="", message=f"收编未成功（可能是授权码过期或无效）。终端尾行：{tail[:220]}")
            return

        acc_dir = ACC_ROOT / saved_acct
        st_file = acc_dir / "status"
        pool_st = st_file.read_text(encoding="utf-8", errors="ignore").strip() if st_file.exists() else "ok"
        if not pool_st.startswith("ok"):
            reason = parse_log_reason(str(acc_dir / "home/.gemini/antigravity-cli/log")) or pool_st
            set_state(
                phase="done",
                url="",
                last_account=saved_acct,
                last_result=f"❌ 不可用（已收编并标 bad）：{reason}",
                message=f"账号 {saved_acct} 已入池，但不可用：{reason}",
            )
            return

        set_state(phase="testing", last_account=saved_acct, message=f"账号 {saved_acct} 已收编，正在执行真实请求 (agy -p) 与 /usage 测额度…")
        ok, detail = test_account_isolated(saved_acct)
        if ok:
            set_state(phase="done", url="", last_account=saved_acct, last_result=f"✅ {detail}", message=f"账号 {saved_acct} 可用！{detail}")
        else:
            set_state(phase="done", url="", last_account=saved_acct, last_result=f"❌ 不可用：{detail}", message=f"账号 {saved_acct} 已入池并标记不可用：{detail}")
    except Exception as e:
        kill_tmux()
        set_state(phase="error", url="", message=f"处理授权码时出错：{e}")


