# agx 配置文件示例：复制到 ~/.config/agx/config.env 并按需取消注释
# 环境变量优先级高于本文件（命令行显式传入优先级最高）。

# 账号池根目录（默认 ~/.local/share/agy-pool）
# AGYX_ROOT="$HOME/.local/share/agy-pool"

# agy 可执行文件路径（默认 ~/.local/bin/agy，找不到时回退 PATH 中的 agy）
# AGYX_AGY="$HOME/.local/bin/agy"

# 出网代理（默认 keep 沿用当前 shell 代理；若需固定走本地 Clash/mihomo，取消下一行注释）
# AGYX_PROXY="http://127.0.0.1:7890"
# AGYX_NO_PROXY="localhost,127.0.0.1,::1,10.0.0.0/8"

# 选号轮转策略：spread（默认：按 (套餐权重×剩余额度)/(1+活跃会话数) + LRU 轮转）| order（固定顺序）
# AGYX_PICK_STRATEGY="spread"
# AGYX_ULTRA_WEIGHT="20.0"
# AGYX_PRO_WEIGHT="1.0"

# 可选优先套餐（留空为全池加权轮转；设为 pro 或 ultra 可限定优先套餐）
# AGYX_PREFER_PLAN=""

# 额度与冷却参数
# AGYX_MIN_PCT="2"          # 某组任一未到期窗口剩余 ≤ 该百分比视为耗尽
# AGYX_COOLDOWN_MIN="15"    # 触发 429 后该模型组的短冷却分钟数（0 关闭）
# AGYX_REFRESH_MIN="30"     # 额度缓存超过该分钟数时 auto 选号先刷新 /usage（0 不自动刷新）
# AGYX_PER_ACCOUNT="0"      # 单账号并发会话上限（0 = 不限）

# agx-web 本地登录面板配置
# AGX_WEB_HOST="127.0.0.1"
# AGX_WEB_PORT="8789"

# agx-appeal-watch 巡检通知命令（可选，stdin 接收 Markdown 报告文本）
# AGX_WATCH_NOTIFY_CMD=""
